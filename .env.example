APP_NAME="Salang MLM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salang_mlm
DB_USERNAME=admin
DB_PASSWORD=Amour7526@

CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — prod Laravel Cloud : MAIL_MAILER=resend + RESEND_KEY (domaine validé Resend)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Resend (https://resend.com) — requis si MAIL_MAILER=resend
RESEND_KEY=
# Exemple prod :
# MAIL_MAILER=resend
# MAIL_FROM_ADDRESS="noreply@votredomaine.com"
# MAIL_FROM_NAME="${APP_NAME}"
# RESEND_KEY=re_xxxxxxxx

CRYPTO_ENABLED=true
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_BASE_URL=https://api.coinbase.com/v2
CRYPTO_FEE=0.5

# Binance Pay (dépôt crypto principal — USDT)
# Merchant Admin Portal → Developers → API Keys
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_CURRENCY=USDT
BINANCE_SERVICE_BASE_URL=https://bpay.binanceapi.com
BINANCE_SERVICE_RETURN_URL="${APP_URL}/payment/success"
BINANCE_SERVICE_CANCEL_URL="${APP_URL}/payment/cancel"
BINANCE_SERVICE_WEBHOOK_URL="${APP_URL}/webhook/binancepay"
# Alias package (optionnel, fallback si BINANCE_PAY_* vides)
BINANCE_MERCHANT_API_KEY=
BINANCE_MERCHANT_SECRET_KEY=

MOBILE_MONEY_ENABLED=true
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=
MOBILE_MONEY_BASE_URL=https://api.orange.com/v1
MOBILE_MONEY_FEE=1.5
MOBILE_MONEY_WEBHOOK_SECRET=

# FlexPay (Mobile Money RDC) — sandbox par défaut
# Doc marchand : credentials fournis par flexpay.cd
FLEXPAY_TOKEN=
FLEXPAY_MERCHANT_CODE=
FLEXPAY_ENV=sandbox
FLEXPAY_ENVIRONMENT=sandbox
FLEXPAY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

BANK_TRANSFER_FEE=0.5

# Stripe / Laravel Cashier
# Doc : https://stripe.com/docs/webhooks/signatures
# Signing secret : Stripe Dashboard → Developers → Webhooks → Signing secret
# Sans ce secret, POST /stripe/webhook n'est PAS vérifié (C1)
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEMCACHED_HOST=127.0.0.1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# true = phase de démo (calcul historique autorisé)
# false = production (runtime uniquement, calcul historique bloqué)
MLM_DEMO_MODE=false